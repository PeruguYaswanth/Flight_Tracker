# Flight Tracker Backend Configuration

# Server Port
PORT=5000
NODE_ENV=production

# CORS allowed origin
# Frontend origin(s), comma-separated, e.g. https://your-app.vercel.app
# Required for sign-in when the frontend is on another site: session cookies
# are only accepted from listed origins ("*" = public reads only).
CORS_ORIGIN=*
# Session cookie attributes. Defaults: production SameSite=None + Secure
# (frontend and API on different sites), development SameSite=Lax.
# COOKIE_SAMESITE=None
# COOKIE_SECURE=true

# Flight search/details provider (AirLabs) - Keep secret! Never expose to client
AIRLABS_API_KEY=19890ad7-6c66-45fb-91c8-195b8ddcae4f
AIRLABS_BASE_URL=https://airlabs.co/api/v9

# Live aircraft position (OpenSky Network) - separate provider, used only
# for real-time lat/lon/heading/altitude/speed. Anonymous access works with
# no key. Only needed if upgrading to a registered OpenSky account for a
# higher request quota.
OPENSKY_CLIENT_ID=yaswanthperugu_28-api-client
OPENSKY_CLIENT_SECRET=V3NIvBBq54oKKvriULfxCSK2nEXjorbM
LIVE_FLIGHT_API_BASE_URL=https://opensky-network.org/api

# Request Timeout (ms)
REQUEST_TIMEOUT_MS=10000

# Account storage (users + login sessions). Required for sign-up/login to
# persist. Local: mongodb://127.0.0.1:27017  |  Hosted (e.g. Render): a
# MongoDB Atlas connection string - keep it secret, it contains credentials.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=flight_tracker
# Days a login session stays valid
SESSION_TTL_DAYS=30
