# Flight Tracker Backend Configuration

# Server Port
PORT=5000
NODE_ENV=production

# CORS allowed origin
CORS_ORIGIN=*

# Flight search/details provider (AirLabs) - Keep secret! Never expose to client
AIRLABS_API_KEY=19890ad7-6c66-45fb-91c8-195b8ddcae4f
AIRLABS_BASE_URL=https://airlabs.co/api/v9

# Live aircraft position (OpenSky Network) - separate provider, used only
# for real-time lat/lon/heading/altitude/speed. Anonymous access works with
# no key. Only needed if upgrading to a registered OpenSky account for a
# higher request quota.
OPENSKY_CLIENT_ID=yaswanthperugu_28-api-client
OPENSKY_CLIENT_SECRET=V3NIvBBq54oKKvriULfxCSK2nEXjorbM
LIVE_FLIGHT_API_BASE_URL=https://opensky-network.org/api

# Request Timeout (ms)
REQUEST_TIMEOUT_MS=10000
